# syntax=docker/dockerfile:1

# ---- builder: install the api dependency-group + project, then bake the model ----
FROM python:3.12-slim AS builder

# uv, pinned for reproducible builds
COPY --from=ghcr.io/astral-sh/uv:0.9.2 /uv /bin/uv

# copy (not symlink) into the venv so it survives the stage copy; use the base image's python
ENV UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    UV_PYTHON_DOWNLOADS=never

WORKDIR /app

# 1) deps only — cached until uv.lock changes, so editing src never reinstalls torch
COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-install-project --no-default-groups --group api

# 2) bake bge-small before copying src, so it depends only on deps — editing code never re-bakes it.
# Image-local cache means cold start loads from disk, never the network.
ENV HF_HOME=/opt/hf
RUN /app/.venv/bin/python -c \
    "from sentence_transformers import SentenceTransformer; SentenceTransformer('BAAI/bge-small-en-v1.5')"

# 3) project, installed into site-packages (no editable link, so runtime needs no src tree)
COPY src ./src
COPY README.md ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-editable --no-default-groups --group api

# ---- runtime: slim, non-root, no build tooling ----
FROM python:3.12-slim AS runtime

RUN useradd --create-home --uid 10001 appuser

# offline: the model is already on disk, refuse any accidental runtime download
ENV HF_HOME=/opt/hf \
    HF_HUB_OFFLINE=1 \
    RULESLAWYER_PROMPTS_DIR=/app/prompts \
    PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1

WORKDIR /app
COPY --from=builder /app/.venv /app/.venv
COPY --from=builder /opt/hf /opt/hf
# versioned prompt files live at repo root, outside the package — copy them in explicitly
COPY prompts ./prompts

USER appuser
EXPOSE 8000

# 200 only after lifespan has loaded the model and opened the DB — a real readiness signal
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
    CMD ["python", "-c", "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://localhost:8000/health').status==200 else 1)"]

CMD ["uvicorn", "ruleslawyer.api.app:app", "--host", "0.0.0.0", "--port", "8000"]
