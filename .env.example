# Copy to .env and fill in. Never commit .env.

# Postgres (matches docker-compose defaults; change both together)
POSTGRES_USER=ruleslawyer
POSTGRES_PASSWORD=ruleslawyer
POSTGRES_DB=ruleslawyer
# For host-run tools (ingest, evals). Inside compose the api service overrides this to @db:5432.
DATABASE_URL=postgresql://ruleslawyer:ruleslawyer@localhost:5432/ruleslawyer

# Embedding model — an experiment parameter, tracked in MLflow (Phase 2), not a constant
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# LLM provider — required by the api service and the generation evals
ANTHROPIC_API_KEY=

# Backend base URL the UI calls. Default suits host dev; compose sets it to http://api:8000.
RULESLAWYER_API_URL=http://localhost:8000
